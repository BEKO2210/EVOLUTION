; Godot 4 project configuration.
;
; Single source of truth for engine settings. Phase 1 — P1-001 (project setup).
; All values that change later (input mappings, autoloads, audio bus layout)
; will be added in subsequent tickets.

config_version=5

[application]

config/name="Evolution"
config/description="Meditative idle-clicker — from a single proto-molecule to cosmic transcendence. Pre-Production phase."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; Order matters — each line below depends only on lines above it.
; GameState        : single source of truth, no deps
; SaveSystem       : reads/writes GameState
; DataLoader       : reads JSON, independent
; AudioManager     : reads GameState.sound flag
; SteamAPI         : independent (stub today)
; Telemetry        : independent (stub today)
; TickSystem       : subscribes via signal, calls SaveSystem.save + reads DataLoader.balance
; ClickSystem      : reads GameState.click_power (derived), writes GameState.dna
; PrestigeSystem   : reads/writes GameState.prestige_points + prestige_multiplier,
;                    invokes GameState.reset_for_prestige() (-> state_reset signal).
;                    Must come BEFORE UpgradeSystem so UpgradeSystem's
;                    state_reset listener picks up the new multiplier on reset.
; UpgradeSystem    : reads DataLoader.upgrades_*, writes GameState.dna/dps/click_power/upgrade_counts,
;                    subscribes to TickSystem.logic_tick for DPS accumulation,
;                    subscribes to GameState.state_reset to recalc after prestige
; StageSystem      : subscribes GameState.total_dna_changed + state_reset,
;                    reads DataLoader.stages, writes GameState.stage,
;                    runs recompute_stage() in _ready() to align loaded saves
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
DataLoader="*res://scripts/autoload/data_loader.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SteamAPI="*res://scripts/autoload/steam_api.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"
TickSystem="*res://scripts/autoload/tick_system.gd"
ClickSystem="*res://scripts/autoload/click_system.gd"
PrestigeSystem="*res://scripts/autoload/prestige_system.gd"
UpgradeSystem="*res://scripts/autoload/upgrade_system.gd"
StageSystem="*res://scripts/autoload/stage_system.gd"

[display]

; 1280x800 is the Steam Deck native resolution and our primary design target.
; UI scales up cleanly for desktop monitors via stretch mode.
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]

; Input actions are added in P1-002 / P1-006 once the click system exists.

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.0196078, 0.027451, 0.0509804, 1)
